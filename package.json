{
  "name": "lot-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Lot Recall: one sentence about a bad batch becomes a checked dry run of PayPal invoice refunds and line removals",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
